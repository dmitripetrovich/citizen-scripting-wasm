#!/bin/bash
set -euo pipefail

usage() {
        echo "Usage: tools/ci/deploy [--fivem] [--redm] [--extra-natives NAME] [--cpp] [--rust] [--both | --runtime-only]"
        echo ""
        echo "  --fivem, --redm Generate natives for these games (default: --fivem)"
        echo "  --extra-natives NAME Add extra natives in tools/natives_extra/NAME.json"
        echo "  --cpp Deploy the C++ part of the example resource"
        echo "  --rust Deploy the Rust part of the example resource"
        echo "  --both Deploy the whole example resource (same as --cpp --rust)"
        echo "  --runtime-only Deploy the runtime without the example resource"
        echo ""
        echo "Without --cpp, --rust, --both or --runtime-only you're asked what to deploy."
}

GAME_ARGS=()
EXTRA_ARGS=()
want_cpp=false
want_rust=false
runtime_only=false
while [ $# -gt 0 ]; do
        arg="$1"
        shift
        case "$arg" in
                --extra-natives)
                        if [ $# -eq 0 ]; then
                                echo "--extra-natives needs a name" >&2
                                exit 1
                        fi
                        EXTRA_ARGS+=(--extra "$1")
                        shift
                        ;;
                --fivem) GAME_ARGS+=(fivem) ;;
                --redm) GAME_ARGS+=(redm) ;;
                --cpp) want_cpp=true ;;
                --rust) want_rust=true ;;
                --both) want_cpp=true; want_rust=true ;;
                --runtime-only) runtime_only=true ;;
                -h|--help)
                        usage
                        exit 0
                        ;;
                *)
                        echo "Unknown argument: $arg" >&2
                        usage >&2
                        exit 1
                        ;;
        esac
done

if $runtime_only && { $want_cpp || $want_rust; }; then
        echo "--runtime-only can't be combined with --cpp, --rust or --both" >&2
        exit 1
fi

choice=""
if $runtime_only; then
        choice=4
elif $want_cpp && $want_rust; then
        choice=3
elif $want_cpp; then
        choice=1
elif $want_rust; then
        choice=2
fi

if [ ${#GAME_ARGS[@]} -eq 0 ]; then
        GAME_ARGS=(fivem)
fi

if [ -z "$choice" ] && [ ! -t 0 ] && [ -c /dev/stdin ]; then
        echo "Error: Pass --cpp, --rust, --both or --runtime-only" >&2
        exit 1
fi

SERVER_DIR="${FX_SERVER_DIR:?Set FX_SERVER_DIR to your cfx-server directory}"
RESOURCE_DIR="${FX_RESOURCE_DIR:?Set FX_RESOURCE_DIR to your resource directory}"
PROJECT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
BUILD_DIR="$PROJECT_DIR/build"

cd "$PROJECT_DIR"

python3 tools/native_db.py --game "${GAME_ARGS[@]}" ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} --embed src/sdk.blob

rm -rf "$BUILD_DIR"

premake5 --os=linux gmake
make -C "$BUILD_DIR" -f citizen-scripting-wasm.make config=release \
        CC="zig cc -target x86_64-linux-musl" \
        CXX="zig c++ -target x86_64-linux-musl" \
        -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 4)" \
        2> >(grep -v "unable to open library directory '/usr/lib64'" >&2 || true)

cp "$BUILD_DIR/bin/Release/libcitizen-scripting-wasm.so" "$SERVER_DIR/"
cp "$PROJECT_DIR/component.json" "$SERVER_DIR/libcitizen-scripting-wasm.json"

if [ -z "$choice" ]; then
        echo ""
        echo "Which part of the example resource do you want to deploy?"
        echo "  1) C++"
        echo "  2) Rust"
        echo "  3) Both"
        echo "  4) Skip (runtime only)"
        if ! read -rp "> " choice; then
                echo "No answer on stdin, pass --cpp, --rust, --both or --runtime-only" >&2
                exit 1
        fi
fi

has_fivem=false
has_redm=false
for game in "${GAME_ARGS[@]}"; do
        case "$game" in
                fivem) has_fivem=true ;;
                redm) has_redm=true ;;
        esac
done

RDR3_WARNING="rdr3_warning 'I acknowledge that this is a prerelease build of RedM, and I am aware my resources *will* become incompatible once RedM ships.'"
if $has_fivem && $has_redm; then
        GAME_LINES="games { 'gta5', 'rdr3' }
$RDR3_WARNING"
elif $has_redm; then
        GAME_LINES="game 'rdr3'
$RDR3_WARNING"
else
        GAME_LINES="game 'gta5'"
fi

MANIFEST_HEADER="fx_version 'cerulean'
$GAME_LINES

name 'example'
author 'dmitripetrovich'
description 'DEPLOY_DESC'
version '1.0.0'"

deploy_example() {
        local label="$1"
        shift
        rm -rf "$RESOURCE_DIR"
        mkdir -p "$RESOURCE_DIR"
        local scripts=""
        for src in "$@"; do
                mkdir -p "$RESOURCE_DIR/$(dirname "$src")"
                cp "tools/example/$src" "$RESOURCE_DIR/$src"
                scripts+="    '$src',"$'\n'
        done
        printf '%s\n\nserver_scripts {\n%s}\n' "${MANIFEST_HEADER/DEPLOY_DESC/Example $label resource.}" "$scripts" > "$RESOURCE_DIR/fxmanifest.lua"
        echo "Resource deployed ($label) -> $RESOURCE_DIR"
}

case "$choice" in
        1) deploy_example "C++" cpp/server.cpp ;;
        2) deploy_example "Rust" rust/server.rs ;;
        3) deploy_example "C++ and Rust" cpp/server.cpp rust/server.rs ;;
        4)
                echo "Skipped resource deployment."
                ;;
        *)
                echo "Invalid choice, skipping resource deployment."
                ;;
esac

echo "Done. Runtime -> $SERVER_DIR"
