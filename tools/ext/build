#!/usr/bin/env bash
set -euo pipefail

[[ $# -ge 1 ]] || { echo "Usage: build <source.cpp|source.rs> [helper.cpp ...]" >&2; exit 2; }

SRC=$1
shift
[[ -f $SRC ]] || { echo "Error: Source not found: $SRC" >&2; exit 1; }

SDK_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
OUT=${SRC%.*}.wasm

case "$SRC" in
        *.cpp)
                exec zig c++ \
                        -target wasm32-wasi \
                        -std=c++23 \
                        -O2 \
                        -fno-exceptions \
                        -mexec-model=reactor \
                        -I"$SDK_DIR" \
                        -Wl,--export-memory \
                        "$SRC" "$@" \
                        -o "$OUT"
                ;;
        *.rs)
                [[ $# -eq 0 ]] || { echo "Error: Rust helpers are pulled in with mod, pass only the script" >&2; exit 2; }
                RLIB="$SDK_DIR/build/libcfx.rlib"
                RLIB_SRC="$SDK_DIR/include/RustSdk.rs"

                if [[ ! -f "$RLIB" ]] || [[ "$RLIB_SRC" -nt "$RLIB" ]]; then
                        mkdir -p "$(dirname "$RLIB")"
                        rustc --crate-type rlib --crate-name cfx --edition 2021 -O \
                                --target wasm32-wasip1 --cfg cfx_has_natives \
                                "$RLIB_SRC" -o "$RLIB"
                fi

                exec rustc --crate-type cdylib --edition 2021 -O \
                        --target wasm32-wasip1 \
                        -C link-args=--export-memory \
                        --extern cfx="$RLIB" \
                        "$SRC" -o "$OUT"
                ;;
        *)
                echo "Error: Unsupported file type: $SRC (expected .cpp or .rs)" >&2
                exit 1
                ;;
esac
